# Copie ce fichier en /etc/budget.env (chmod 600, propriétaire root) puis : systemctl restart budget
# Adresse publique de l'appli (sans / final). Obligatoire pour envoyer les liens.
BASE_URL=https://budget.exemple.fr
# Serveur d'envoi (port 465 = TLS direct, port 587 = STARTTLS)
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=budget@exemple.fr
SMTP_PASS=mot-de-passe-ou-mot-de-passe-d-application
SMTP_FROM=Budget <budget@exemple.fr>
